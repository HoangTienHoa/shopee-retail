# Shared defaults for running services on the host (npm run dev) against infra in Docker.
NODE_ENV=development
LOG_LEVEL=info

# directConnection=true: talk straight to the single-node replica set primary,
# so the driver does not try to resolve the in-Docker member host "mongo:27017".
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
